{
  "name": "@nirmitee/abdm-sdk-node",
  "version": "1.0.0",
  "description": "Node.js SDK for Ayushman Bharat Digital Mission (ABDM)",
  "main": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rimraf dist && tsc",
    "prepare": "husky install && npm run build",
    "prepublishOnly": "npm run lint && npm test",
    "lint": "eslint . --ext .ts,.tsx --cache --fix",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && jest --passWithNoTests",
    "test:unit": "tsc -p tsconfig.test.json && jest --passWithNoTests test/unit",
    "test:integration": "tsc -p tsconfig.test.json && jest --passWithNoTests test/integration",
    "test:watch": "tsc -p tsconfig.test.json && jest --watch",
    "test:coverage": "tsc -p tsconfig.test.json && jest --coverage --collectCoverageFrom='src/**/*.ts' --collectCoverageFrom='!src/**/*.d.ts' --collectCoverageFrom='!src/index.ts'",
    "test:ci": "npm run lint && tsc -p tsconfig.test.json && npm run test:coverage",
    "test:m1": "tsc -p tsconfig.test.json && jest test/m1.service.test.ts",
    "test:m2": "tsc -p tsconfig.test.json && jest test/m2.service.test.ts",
    "test:m3": "tsc -p tsconfig.test.json && jest test/m3.service.test.ts",
    "docs": "typedoc --out docs src",
    "check-types": "tsc --noEmit",
    "preinstall": "npx only-allow npm || npx only-allow pnpm || npx only-allow yarn",
    "validate": "npm run lint && npm run typecheck && npm test",
    "prettier": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "keywords": [
    "abdm",
    "ayushman-bharat",
    "sdk",
    "node",
    "healthcare",
    "india",
    "api"
  ],
  "author": "Pradhyuman Singh Rao (https://github.com/pradhyuman-nirmitee)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nirmitee-tech/abdm-sdk-node.git"
  },
  "bugs": {
    "url": "https://github.com/Nirmitee-tech/abdm-sdk-node/issues"
  },
  "homepage": "https://github.com/Nirmitee-tech/abdm-sdk-node#readme",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=7.0.0",
    "yarn": ">=1.22.0",
    "pnpm": ">=6.0.0"
  },
  "packageManager": "yarn@1.22.22",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "typescript": ">=4.0.0"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "form-data": "^4.0.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "8.19.0",
    "pino-pretty": "10.3.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "20.19.0",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "dotenv": "16.5.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jest": "28.13.0",
    "eslint-plugin-prettier": "5.4.1",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "prettier": "3.5.3",
    "rimraf": "^5.0.5",
    "ts-jest": "29.3.4",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "tslib": "2.8.1",
    "typedoc": "^0.25.3",
    "typescript": "5.8.3"
  }
}
