# Configure the default package registry
registry=https://registry.npmjs.org/

# Save exact version in package.json
save-exact=true

# Use package-lock.json
package-lock=true

# Use the latest version of npm
engine-strict=true

# Configure the package access
access=public

# Configure the package tag when publishing
tag=latest

# Configure the package cache
cache-min=10

# Configure the package loglevel
loglevel=error

# Configure the package scripts-prepend-node-path
auto-install-peers=true

# Configure the package strict-ssl
strict-ssl=true

# Configure the package proxy
# proxy=http://proxy.company.com:8080
# https-proxy=http://proxy.company.com:8080
# noproxy=*.company.com,localhost
