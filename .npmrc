# Package Registry Configuration
registry=https://registry.npmjs.org/

# Save exact versions in package.json
save-exact=true

# Package Manager Configuration
engine-strict=true
package-lock=true
lockfile-version=3

# Cache and Temporary Files
cache=${HOME}/.npm
prefer-offline=true
update-notifier=false

# Network Configuration
fetch-retries=3
fetch-timeout=120000
prefer-offline=true

# Logging Configuration
loglevel=error
progress=false

# Security Configuration
strict-ssl=true

# Workspace Configuration (for monorepos)
workspaces-prefix=all

# pnpm Configuration
shamefully-hoist=true
strict-peer-dependencies=false
auto-install-peers=true

# Yarn Configuration
yarn-path .yarn/releases/yarn-3.6.4.js

# Configure the package access
access=public

# Configure the package tag when publishing
tag=latest

# Configure the package cache
cache-min=10

# Configure the package loglevel
loglevel=error

# Configure the package scripts-prepend-node-path
auto-install-peers=true

# Configure the package strict-ssl
strict-ssl=true

# Configure the package proxy
# proxy=http://proxy.company.com:8080
# https-proxy=http://proxy.company.com:8080
# noproxy=*.company.com,localhost
