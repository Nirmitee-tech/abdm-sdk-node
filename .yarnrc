# This file is for Yarn 1.x configuration
# For Yarn 2+, use .yarnrc.yml

# Configure the registry
registry "https://registry.npmjs.org"

# Configure the cache folder
cache-folder ".yarn/cache"

# Configure the offline mode
offline false

# Configure the network concurrency
network-concurrency 8

# Configure the network timeout
network-timeout 300000

# Configure the prefer offline mode
prefer-offline false

# Configure the production flag
production false

# Configure the save exact
save-exact true

# Configure the save prefix
save-prefix ""

# Configure the strict ssl
strict-ssl true

# Configure the user agent
user-agent "yarn/1.22.19 npm/? node/v16.14.2 darwin x64"
